# ---------- URLs ----------
# The URL of THIS Next.js app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
# The URL of the Express server (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000

# ---------- Better Auth ----------
# A long random string. Create one with:  npx @better-auth/cli secret   (or any 32+ character random text)
BETTER_AUTH_SECRET=

# ---------- MongoDB (must be the SAME database the server uses) ----------
MONGODB_URI=
DB_NAME=salonbook

# ---------- Google login ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- ImgBB (image upload) ----------
IMGBB_API_KEY=
